# Copy to .env on the NAS (never commit .env).
HOMEBASE_PORT=8770
# Shared token the TVs send as "Authorization: Bearer <token>".
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HOMEBASE_API_TOKEN=change-me
# Emby (Phase 1B)
HOMEBASE_EMBY_URL=http://192.168.1.143:8096
HOMEBASE_EMBY_API_KEY=
# Trakt (Phase 2D): Nuvio's Continue Watching and Watchlist. Client ID of your own Trakt API app; no secret needed.
# Sign in once: docker exec -it homebase-tv-backend python -m app.integrations.trakt
HOMEBASE_TRAKT_CLIENT_ID=
# Favorite Channels (Phase 2E): shortcuts that open TiviMate, as "streamID=Name" in row order.
HOMEBASE_IPTV_CHANNELS=534104=The Simpsons,91950=Dog TV
# Optional Xtream Codes M3U URL, used only to look up those channels' logos (never streams).
HOMEBASE_IPTV_M3U_URL=
# Trending Movies/Series (Phase 2G): Nuvio's official TMDB catalog addon. Leave empty to hide those rows.
HOMEBASE_NUVIO_CATALOG_URL=https://catalog.nuvio.tv
