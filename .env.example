# Copy to .env on the NAS (never commit .env).
HOMEBASE_PORT=8770
# Shared token the TVs send as "Authorization: Bearer <token>".
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HOMEBASE_API_TOKEN=change-me
# Emby (Phase 1B)
HOMEBASE_EMBY_URL=http://192.168.1.143:8096
HOMEBASE_EMBY_API_KEY=
# Trakt (Phase 2D): Nuvio's Continue Watching and Watchlist. Client ID of your own Trakt API app; no secret needed.
# Sign in once: docker exec -it homebase-tv-backend python -m app.integrations.trakt
HOMEBASE_TRAKT_CLIENT_ID=
